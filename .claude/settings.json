{
  "defaults": {
    "language": "chinese",
    "auto_create_files": true,
    "preferred_tool": "platformio",
    "default_environment": "esp32s3",
    "auto_flash_after_build": false,
    "build_on_save": false,
    "require_permission_for_files": ["*.py", "*.js", "*.html"],
    "auto_format_code": true,
    "run_linting_after_build": true,
    "verbose": false
  },
  "permissions": {
    "allow": [
      "Bash(scp*)",
      "Bash(ssh*)",
      "Bash(npm*)",
      "Bash(git*)",
      "Bash(ls*)",
      "Bash(cp*)",
      "Bash(mkdir*)",
      "Bash(tee*)",
      "Bash(timeout*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(awk*)",
      "Bash(sed*)",
      "Bash(find*)",
      "Bash(xargs*)",
      "Bash(du*)",
      "Bash(ssh-keygen*)",
      "Bash(ssh-add*)",
      "Bash(rsync*)",
      "Bash(unzip*)",
      "Bash(zip*)",
      "Bash(tar*)",
      "Bash(ln*)",
      "Bash(ps*)",
      "Bash(top*)",
      "Bash(free*)",
      "Bash(netstat*)",
      "Bash(ifconfig*)",
      "Bash(ip*)",
      "Bash(journalctl*)",
      "Bash(alias*)",
      "Bash(whoami*)",
      "Bash(id*)",
      "Bash(date*)",
      "Bash(uptime*)",
      "Bash(lsof*)",
      "Bash(python -m platformio*)",
      "Bash(docker restart*)",
      "Bash(docker compose restart*)",
      "Edit(*)",
      "Read(*)",
      "Grep(*)",
      "Bash(pio run *)",
      "Bash(idf.py *)",
      "Bash(pio run -e esp32s3 *)",
      "Bash(pio run -e squeezeamp *)",
      "Bash(pio run -e esparagus-audio-brick *)",
      "Bash(pio run -e esparagus-louder *)",
      "Bash(pio run -e esp32s3-jtag *)"
    ],
    "deny": [
      "Bash(systemctl*)",
      "Bash(service*)",
      "Bash(crontab*)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Bash(export*)",
      "Bash(unset*)",
      "Bash(unalias*)",
      "Bash(history*)",
      "Bash(who*)",
      "Bash(last*)",
      "Bash(dmesg*)",
      "Bash(strace*)",
      "Bash(chown*)",
      "Bash(systemctl*)",
      "Bash(service*)",
      "Bash(crontab*)",
      "Edit(/etc/*)",
      "Edit(/var/*)",
      "Edit(/proc/*)",
      "Edit(/sys/*)",
      "Bash(mount*)",
      "Bash(umount*)",
      "Bash(reboot*)",
      "Bash(shutdown*)",
      "Bash( halt*)"
    ]
  }
}